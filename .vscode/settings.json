{
    // ========== CMake 核心配置 ==========
    
    // CMakeLists.txt 所在路径（相对于工作区根目录）
    "cmake.sourceDirectory": "${workspaceFolder}",
    
    // 构建目录（使用项目内的 build 文件夹）
    "cmake.buildDirectory": "${workspaceFolder}/build",
    
    // 保存时自动配置 CMake
    "cmake.configureOnEdit": true,
    
    // 打开项目时自动配置
    "cmake.configureOnOpen": true,
    
    // 构建前自动保存所有文件
    "cmake.saveBeforeBuild": true,
    
    // 构建任务（使用 CMake Tools 扩展）
    "cmake.buildTask": true,
    
    // 生成器配置（Windows 推荐，根据你的编译器选择其一）
    // 如果使用 MinGW-w64：
    "cmake.generator": "MinGW Makefiles",
    
    // 如果使用 Visual Studio 2022：
    // "cmake.generator": "Visual Studio 17 2022",
    
    // 如果使用 Ninja：
    // "cmake.generator": "Ninja",
    
    // 指定 CMake 可执行文件路径（如果不在环境变量中，取消注释并修改）
    // "cmake.cmakePath": "C:\\Program Files\\CMake\\bin\\cmake.exe",
    
    // ========== C/C++ 扩展配置 ==========
    
    // 编译器路径（根据你的实际安装路径修改）
    "C_Cpp.default.compilerPath": "C:/mingw64/bin/g++.exe",
    
    // 默认 IntelliSense 模式
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    
    // 默认 C++ 标准
    "C_Cpp.default.cppStandard": "c++17",
    
    // ========== 文件关联 ==========
    
    "files.associations": {
        "*.h": "cpp"
    }
}